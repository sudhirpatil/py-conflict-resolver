# Copy this file to .env and fill in the values for your chosen LLM provider.
# Only the key for your active provider (set in config.toml) is required.

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── Optional config overrides ─────────────────────────────────────────────────
# These mirror the CLI flags and config.toml settings.
# Values here are overridden by explicit CLI flags (--provider, --model, etc.).
#
# CONFLICT_RESOLVER_PROVIDER=openai
# CONFLICT_RESOLVER_MODEL=gpt-4.1
# CONFLICT_RESOLVER_MAX_LOOPS=10
